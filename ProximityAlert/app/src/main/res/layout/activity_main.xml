<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0C10">

    <!-- HEADER -->
    <LinearLayout android:id="@+id/header"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:background="#12151C" android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="ProximityAlert"
            android:textColor="#E8ECF4" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="IDLE" android:textColor="#5A6278"
            android:textSize="11sp" android:textStyle="bold"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="10dp" android:paddingVertical="4dp"/>
    </LinearLayout>

    <!-- MAP — takes all remaining space -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"/>

    <!-- LOADING SPINNER -->
    <ProgressBar android:id="@+id/mapLoadingProgress"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@id/mapView"
        app:layout_constraintBottom_toBottomOf="@id/mapView"
        app:layout_constraintStart_toStartOf="@id/mapView"
        app:layout_constraintEnd_toEndOf="@id/mapView"/>

    <!-- FAB MY LOCATION — anchored to map bottom right, fixed position -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginEnd="14dp" android:layout_marginBottom="14dp"
        android:contentDescription="My Location"
        app:srcCompat="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="#2979FF" app:tint="@android:color/white"
        app:fabSize="mini"
        app:layout_constraintEnd_toEndOf="@id/mapView"
        app:layout_constraintBottom_toBottomOf="@id/mapView"/>

    <!-- BOTTOM PANEL -->
    <LinearLayout android:id="@+id/bottomPanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#12151C" android:elevation="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Stats bar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:background="#0F1218" android:paddingHorizontal="8dp"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvDistance"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textColor="#00C9FF"
                    android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DIST" android:textColor="#5A6278" android:textSize="8sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvRadiusStats"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="100m" android:textColor="#00C9FF"
                    android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="RADIUS" android:textColor="#5A6278" android:textSize="8sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvAccuracy"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textColor="#00C9FF"
                    android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="GPS" android:textColor="#5A6278" android:textSize="8sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Controls area -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp" android:paddingTop="10dp" android:paddingBottom="12dp">

            <!-- Radius slider -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:layout_marginBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Radius" android:textColor="#5A6278"
                    android:textSize="11sp" android:layout_marginEnd="8dp"/>
                <SeekBar android:id="@+id/seekBarRadius"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="#00F5A0" android:thumbTint="#00F5A0"/>
                <TextView android:id="@+id/tvRadius"
                    android:layout_width="48dp" android:layout_height="wrap_content"
                    android:gravity="end" android:text="100m"
                    android:textColor="#00F5A0" android:textSize="11sp"
                    android:textStyle="bold" android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Search panel — HIDDEN by default, shown when search tapped -->
            <LinearLayout android:id="@+id/searchPanel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Address search row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <EditText android:id="@+id/etAddressSearch"
                        android:layout_width="0dp" android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="Search place or address..."
                        android:textSize="12sp" android:background="@drawable/bg_input"
                        android:paddingHorizontal="10dp"
                        android:textColor="#E8ECF4" android:textColorHint="#5A6278"
                        android:inputType="text" android:imeOptions="actionSearch"
                        android:maxLines="1" android:layout_marginEnd="6dp"/>
                    <Button android:id="@+id/btnSearchAddress"
                        android:layout_width="80dp" android:layout_height="44dp"
                        android:text="Search" android:textSize="11sp"
                        android:backgroundTint="#00C896" android:textColor="#0A0C10"/>
                </LinearLayout>

                <!-- Search results list — shown after search -->
                <LinearLayout android:id="@+id/searchResultsPanel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="#181C26"
                    android:layout_marginBottom="8dp">
                    <Button android:id="@+id/btnResult1"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:gravity="start|center_vertical"
                        android:paddingHorizontal="12dp"
                        android:textSize="11sp" android:textColor="#E8ECF4"
                        android:backgroundTint="#181C26"
                        android:ellipsize="end" android:maxLines="2"
                        android:visibility="gone"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#1F2535"/>
                    <Button android:id="@+id/btnResult2"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:gravity="start|center_vertical"
                        android:paddingHorizontal="12dp"
                        android:textSize="11sp" android:textColor="#E8ECF4"
                        android:backgroundTint="#181C26"
                        android:ellipsize="end" android:maxLines="2"
                        android:visibility="gone"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#1F2535"/>
                    <Button android:id="@+id/btnResult3"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:gravity="start|center_vertical"
                        android:paddingHorizontal="12dp"
                        android:textSize="11sp" android:textColor="#E8ECF4"
                        android:backgroundTint="#181C26"
                        android:ellipsize="end" android:maxLines="2"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- GPS Coordinates row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <EditText android:id="@+id/etLatitude"
                        android:layout_width="0dp" android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="Lat (13.0827)"
                        android:textSize="11sp" android:background="@drawable/bg_input"
                        android:paddingHorizontal="10dp"
                        android:textColor="#E8ECF4" android:textColorHint="#5A6278"
                        android:inputType="numberDecimal|numberSigned"
                        android:maxLines="1" android:layout_marginEnd="4dp"/>
                    <EditText android:id="@+id/etLongitude"
                        android:layout_width="0dp" android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="Lon (80.2707)"
                        android:textSize="11sp" android:background="@drawable/bg_input"
                        android:paddingHorizontal="10dp"
                        android:textColor="#E8ECF4" android:textColorHint="#5A6278"
                        android:inputType="numberDecimal|numberSigned"
                        android:maxLines="1" android:layout_marginEnd="4dp"/>
                    <Button android:id="@+id/btnSetCoords"
                        android:layout_width="60dp" android:layout_height="44dp"
                        android:text="Set" android:textSize="11sp"
                        android:backgroundTint="#2D7DD2" android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Action buttons row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">

                <!-- Long press map hint -->
                <Button android:id="@+id/btnSetTarget"
                    android:layout_width="0dp" android:layout_height="42dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:text="📍 Drop Pin"
                    android:backgroundTint="#1C2133" android:textColor="#A0A8C0"
                    android:textSize="11sp"/>

                <!-- Search toggle -->
                <Button android:id="@+id/btnToggleSearch"
                    android:layout_width="0dp" android:layout_height="42dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:text="🔍 Search"
                    android:backgroundTint="#1C2133" android:textColor="#A0A8C0"
                    android:textSize="11sp"/>

                <!-- Favourites -->
                <Button android:id="@+id/btnFavourites"
                    android:layout_width="0dp" android:layout_height="42dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    android:text="⭐ Saved"
                    android:backgroundTint="#1C2133" android:textColor="#A0A8C0"
                    android:textSize="11sp"/>

                <!-- History -->
                <Button android:id="@+id/btnHistory"
                    android:layout_width="0dp" android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="📋 Log"
                    android:backgroundTint="#1C2133" android:textColor="#A0A8C0"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- Start / Stop -->
            <Button android:id="@+id/btnStartStop"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="▶  Start Monitoring"
                android:textStyle="bold" android:textSize="13sp"
                android:backgroundTint="#00F5A0" android:textColor="#0A0C10"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ALARM OVERLAY with RGB border -->
    <FrameLayout android:id="@+id/alarmOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#F0000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- RGB animated border strips -->
        <View android:id="@+id/rgbTop"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_gravity="top" android:background="#FFFF0000"/>
        <View android:id="@+id/rgbBottom"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_gravity="bottom" android:background="#FF00FF00"/>
        <View android:id="@+id/rgbLeft"
            android:layout_width="6dp" android:layout_height="match_parent"
            android:layout_gravity="start" android:background="#FF0000FF"/>
        <View android:id="@+id/rgbRight"
            android:layout_width="6dp" android:layout_height="match_parent"
            android:layout_gravity="end" android:background="#FFFF0000"/>

        <!-- Alarm card -->
        <LinearLayout
            android:layout_width="300dp" android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_alarm_card"
            android:gravity="center" android:orientation="vertical"
            android:padding="32dp">

            <TextView android:id="@+id/tvAlarmBell"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔔" android:textSize="52sp"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ZONE ENTERED!"
                android:textColor="#FF4D6D" android:textSize="24sp"
                android:textStyle="bold" android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/tvAlarmDist"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#AAAAAA" android:textSize="13sp"
                android:gravity="center" android:paddingHorizontal="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/tvAlarmLocation"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#5A6278" android:textSize="11sp"
                android:gravity="center" android:paddingHorizontal="8dp"
                android:layout_marginBottom="28dp"/>

            <Button android:id="@+id/btnDismissAlarm"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:text="✕  Dismiss Alarm"
                android:backgroundTint="#3DFF4D6D"
                android:textColor="#FF4D6D" android:textStyle="bold"/>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>