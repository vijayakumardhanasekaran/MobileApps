<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#12151C"
    android:paddingBottom="24dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp" android:layout_marginBottom="16dp"
        android:background="#3A3F50"/>

    <!-- Title -->
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📋  Alarm History"
        android:textColor="#E8ECF4" android:textSize="16sp" android:textStyle="bold"
        android:paddingHorizontal="20dp" android:paddingBottom="12dp"/>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#1F2535"/>

    <!-- Empty state -->
    <TextView android:id="@+id/tvHistoryEmpty"
        android:layout_width="match_parent" android:layout_height="80dp"
        android:gravity="center"
        android:text="No alarms triggered yet."
        android:textColor="#5A6278" android:textSize="13sp"
        android:visibility="gone"/>

    <!-- List -->
    <ListView android:id="@+id/listHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="360dp"
        android:scrollbars="none"
        android:divider="#1F2535"
        android:dividerHeight="1dp"/>

    <!-- Clear button -->
    <Button android:id="@+id/btnClearHistory"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp"
        android:text="🗑  Clear All History"
        android:textSize="13sp"
        android:backgroundTint="#2A1C1C"
        android:textColor="#FF4D6D"
        android:visibility="gone"/>

</LinearLayout>